# Server Configuration
PORT=3001

# Chrome DevTools Protocol Endpoint (Assumes Chrome started with --remote-debugging-port=9222)
CDP_ENDPOINT=http://localhost:9222

# Optional: LLM API Keys (If left blank, the agent uses its built-in intelligent JSON matching engine)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Supabase (server only — never put the service role key in frontend code)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails that can open the Admin page (block / unblock users)
ADMIN_EMAILS=

GROQ_API_KEY=
